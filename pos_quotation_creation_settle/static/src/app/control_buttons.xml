<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_quotation_creation_settle.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div" position="inside">
            <button t-if="pos.config.pqs_quotation_enabled"
                    class="pqs-create-quotation-button"
                    t-att-class="buttonClass"
                    t-on-click="() => this.pos.pqsCreateQuotation()">
                <i class="fa fa-file-text-o me-1" role="img" aria-label="Create Quotation" title="Create Quotation"/>
                Create Quotation
            </button>
        </xpath>
    </t>

</templates>
